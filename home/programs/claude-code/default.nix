# The VS Code extension (anthropic.claude-code) ships its own `claude` binary in
# resources/native-binary/, which is dynamically linked against a generic Linux
# loader and therefore cannot run on NixOS.
#
# The extension supports the `claudeCode.claudeProcessWrapper` setting: when it
# is set, the process is spawned as
#     <wrapper> <bundled-binary> <args...>
# so a wrapper that drops the bundled path and execs the Nix-provided `claude`
# makes the extension work without patchelf or nix-ld.
{ config, lib, pkgs, ... }:

let
  wrapper = pkgs.writeShellScriptBin "claude-code-vscode-wrapper" ''
    case "''${1-}" in
      */resources/native-binar*/claude|*/resources/claude-code/cli.js) shift ;;
    esac
    exec ${pkgs.claude-code}/bin/claude "$@"
  '';

  wrapperPath = "${wrapper}/bin/claude-code-vscode-wrapper";
  settingsPath = "${config.home.homeDirectory}/.config/Code/User/settings.json";
in
{
  home.packages = [ wrapper ];

  # settings.json is patched in place instead of being generated by
  # programs.vscode, so that VS Code itself can keep writing to it.
  home.activation.vscodeClaudeProcessWrapper =
    lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      settings="${settingsPath}"
      mkdir -p "$(dirname "$settings")"
      [ -e "$settings" ] || echo '{}' > "$settings"
      if ${pkgs.jq}/bin/jq --arg w "${wrapperPath}" \
           '.["claudeCode.claudeProcessWrapper"] = $w' "$settings" > "$settings.tmp"; then
        mv "$settings.tmp" "$settings"
      else
        rm -f "$settings.tmp"
        echo "warning: $settings is not valid JSON; set claudeCode.claudeProcessWrapper to ${wrapperPath} manually"
      fi
    '';
}
